#!/bin/sh
# Runs transit-format's verify harness against this implementation (via
# bin/roundtrip) in each encoding, and fails if any roundtrip does.
# transit-format's own bin/verify needs Maven; this uses the clojure CLI.
#
# usage: bin/verify [transit-format checkout] [number of generated forms]
#        (defaults: ../transit-format, 100)

set -e
FORMAT=`cd "${1:-\`dirname $0\`/../../transit-format}" && pwd`
cd `dirname $0`/..
HERE=`pwd`
GEN=${2:-100}
PROJECT=`python3 -c "import os, sys; print(os.path.relpath(sys.argv[1], os.path.dirname(sys.argv[2])))" "$HERE" "$FORMAT"`
DEPS='{:paths ["src"] :deps {org.clojure/clojure {:mvn/version "1.12.4"} com.cognitect/transit-clj {:mvn/version "1.1.347"} org.clojure/data.generators {:mvn/version "1.1.1"} commons-codec/commons-codec {:mvn/version "1.21.0"}}}'
# Build or install whatever bin/roundtrip needs first, so the harness's
# per-value timeout doesn't include it.
bin/roundtrip json < /dev/null > /dev/null

LOG=`mktemp`
trap 'rm -f "$LOG"' EXIT
status=0
for enc in json json-verbose msgpack; do
  (cd "$FORMAT" && clojure -Sdeps "$DEPS" -M -e "
    (require 'transit.verify 'transit.generators)
    (binding [transit.verify/*style* false]
      (transit.verify/verify-encodings \"$PROJECT\"
        {:enc :$enc :gen $GEN :generated-forms (doall (take $GEN (repeatedly transit.generators/ednable)))}))
    (shutdown-agents)") > "$LOG" 2>&1 || true
  grep -a -E '^(Project|[0-9]+ (successful|roundtrip))' "$LOG" | tr '\n' ' '
  echo
  if grep -a -q -E 'roundtrip error|Read Error|Response Timeout|Disconnected|Exception' "$LOG" ||
     ! grep -a -q 'successful' "$LOG"; then
    grep -a -E -A3 'roundtrip error|Read Error|Response Timeout|Disconnected|Exception' "$LOG" | cut -c1-300
    if [ -n "$GITHUB_ACTIONS" ]; then
      # annotations, which show on the workflow run
      grep -a -E -A3 'roundtrip error|Read Error|Response Timeout|Disconnected|Exception' "$LOG" | head -12 |
        cut -c1-300 | while IFS= read -r line; do echo "::error::$enc: $line"; done
    fi
    status=1
  fi
done
exit $status
